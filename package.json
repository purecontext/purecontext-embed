{
  "name": "@purecontext/embed",
  "version": "0.1.2",
  "description": "One embedding model per machine: a small service that loads an ONNX text-embedding model once and serves every process that needs vectors",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "bin": {
    "purecontext-embed": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "tsc",
    "test": "tsc && node --test --test-concurrency=1 test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/purecontext/purecontext-embed.git"
  },
  "license": "MIT",
  "keywords": ["embeddings", "onnx", "fastembed", "service", "bge"],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fastembed": "^2.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "onnxruntime-node"]
  }
}
